{
  "info": {
    "name": "PayPilot API Collection",
    "_postman_id": "paypilot-collection-v1",
    "description": "Collection for testing PayPilot Autonomous Governance, PayPal Orders v2, and Webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth - Demo Sign In",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoUserEmail}}\",\n  \"password\": \"{{demoUserPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/sign-in/email",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "sign-in", "email"]
        }
      }
    },
    {
      "name": "Submit Purchase Intent (Prompt 1)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rawInput\": \"I need a developer monitor under $250. Prioritize text clarity and value.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/intents",
          "host": ["{{baseUrl}}"],
          "path": ["intents"]
        }
      }
    },
    {
      "name": "List Purchase Plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/plans",
          "host": ["{{baseUrl}}"],
          "path": ["plans"]
        }
      }
    },
    {
      "name": "Evaluate Plan Governance",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/plans/{{planId}}/evaluate",
          "host": ["{{baseUrl}}"],
          "path": ["plans", "{{planId}}", "evaluate"]
        }
      }
    },
    {
      "name": "Approve Purchase Plan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Authorized via Postman test runner\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/plans/{{planId}}/approve",
          "host": ["{{baseUrl}}"],
          "path": ["plans", "{{planId}}", "approve"]
        }
      }
    },
    {
      "name": "Initialize PayPal Payment",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/plans/{{planId}}/pay",
          "host": ["{{baseUrl}}"],
          "path": ["plans", "{{planId}}", "pay"]
        }
      }
    },
    {
      "name": "Capture PayPal Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{paypalOrderId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payments/{{paymentId}}/capture",
          "host": ["{{baseUrl}}"],
          "path": ["payments", "{{paymentId}}", "capture"]
        }
      }
    },
    {
      "name": "Simulate Webhook (PAYMENT.CAPTURE.COMPLETED)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventType\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"orderId\": \"{{paypalOrderId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/dev/webhooks/simulate",
          "host": ["{{baseUrl}}"],
          "path": ["dev", "webhooks", "simulate"]
        }
      }
    },
    {
      "name": "Start Agent Negotiation",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/plans/{{planId}}/negotiate",
          "host": ["{{baseUrl}}"],
          "path": ["plans", "{{planId}}", "negotiate"]
        }
      }
    },
    {
      "name": "Get User Policy",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/policies/me",
          "host": ["{{baseUrl}}"],
          "path": ["policies", "me"]
        }
      }
    },
    {
      "name": "Get Unified Timeline",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/timeline",
          "host": ["{{baseUrl}}"],
          "path": ["timeline"]
        }
      }
    },
    {
      "name": "Simulate Policy",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"category\":\"Electronics\",\"amount\":50,\"merchant\":\"Demo merchant\"}" },
        "url": { "raw": "{{baseUrl}}/policies/simulate", "host": ["{{baseUrl}}"], "path": ["policies", "simulate"] }
      }
    },
    {
      "name": "Verify Trust Receipt",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/receipts/{{paymentId}}/verify", "host": ["{{baseUrl}}"], "path": ["receipts", "{{paymentId}}", "verify"] }
      }
    }
  ]
}
