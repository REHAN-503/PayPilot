# Aggregate reference only; apps load their own env files.

# Database
DATABASE_URL="postgresql://paypilot:paypilot_password@localhost:5432/paypilot?schema=public"

# Authentication
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"

# API runtime
PORT=4000
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://your-public-frontend.example.com"

# Demo and behavior
DEMO_MODE=true
DEMO_USER_PASSWORD="Password123!"
LLM_FORCE_LIVE=false
ENABLE_WEBHOOK_SIMULATOR=false

# AI provider
LLM_PROVIDER="openrouter"
LLM_MODEL="openai/gpt-4o-mini"
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# PayPal
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CURRENCY=USD
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# Web client
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
NEXT_PUBLIC_PAYPAL_CURRENCY=USD
