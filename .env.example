# PayPilot Root Environment Variables Template

# Apps API Configuration
DATABASE_URL="postgresql://paypilot:paypilot_password@localhost:5432/paypilot?schema=public"
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
PORT=4000
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
DEMO_MODE=true
DEMO_USER_PASSWORD="Password123!"

# AI / LLM Configuration (Optional when DEMO_MODE=true)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
LLM_MODEL="claude-3-5-sonnet-20241022"

# PayPal Sandbox REST API Credentials
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"

# Web App Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"

