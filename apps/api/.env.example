# PostgreSQL Database URL
DATABASE_URL="postgresql://paypilot:paypilot_password@localhost:5432/paypilot?schema=public"

# Better Auth Configuration
BETTER_AUTH_URL="http://localhost:4000"
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"

# Server Port & Allowed Origins
PORT=4000
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Demo / live mode
# DEMO_MODE=true allows deterministic fixtures and (non-production) dev simulator when explicitly enabled.
# For a public production deployment use DEMO_MODE=false with live LLM + live PayPal Sandbox.
DEMO_MODE=true
LLM_FORCE_LIVE=false
ENABLE_WEBHOOK_SIMULATOR=false

# Demo User Password (seeded automatically if not set)
DEMO_USER_PASSWORD="Password123!"

# AI / LLM Configuration
# LLM_PROVIDER is authoritative: "gemini" or "anthropic"
# Live AI requires the matching API key and a valid LLM_MODEL. With DEMO_MODE=true and no key,
# PayPilot may use deterministic fixtures as fallback and the UI/timeline will label fallback.
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key"
ANTHROPIC_API_KEY="your_anthropic_api_key"
LLM_MODEL="gemini-2.0-flash"

# PayPal Sandbox REST API Credentials (Orders v2)
# In production (NODE_ENV=production), webhook skip/simulator paths are refused even if DEMO_MODE=true.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CURRENCY=USD
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"
