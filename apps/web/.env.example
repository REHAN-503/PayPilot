# PayPilot Web App Environment Configuration

# Backend API URL (used by Next.js rewrites/proxy)
NEXT_PUBLIC_API_URL=http://localhost:4000

# PayPal Sandbox Client ID for Smart Buttons (must match the same PayPal app as API PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Currency used for client-side display/checkout hints
NEXT_PUBLIC_PAYPAL_CURRENCY=USD
